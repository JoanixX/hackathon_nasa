# Copy to .env (never commit .env). All values are read only by the API and workers.

# Actual AI inference (required for the AI scene gate). Leave empty to keep AI generation blocked.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# "gemini" for actual inference, or "fixture" for labeled offline development (never counts as AI).
RAIZ_AI_PROVIDER=gemini
RAIZ_AI_TIMEOUT_S=60

# Optional: Earthdata login for authorized NISAR GCOV download (discovery works without it).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Job limits.
RAIZ_MAX_QUEUE_DEPTH=20
RAIZ_JOB_LEASE_S=300
RAIZ_MAX_JOB_ATTEMPTS=3
