{
  "name": "raiz-sar-ai-qa",
  "private": true,
  "description": "Browser and JavaScript QA tooling for Ayumi. Not a production runtime.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test:props": "node --test tests/js/*.property.test.mjs",
    "test:e2e": "playwright test --config tests/js/playwright.config.mjs",
    "ar:target": "node tools/build_ar_target.mjs",
    "test:perf": "node tests/js/perf_session.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "fast-check": "4.8.0"
  }
}
